---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { LangKey } from '../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);

const waHref =
  'https://api.whatsapp.com/send?phone=6281289895646&text=Hello%20Cardi!!%20I%20would%20like%20to%20consult%20about%20the%20business%20ecosystem.%20%F0%9F%98%81%F0%9F%98%81';
---

<a
  class="wa-float"
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t('nav.cta')}
  title={t('nav.cta')}
>
  <span class="wa-float-pulse" aria-hidden="true"></span>
  <svg class="wa-float-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.2 2.4 1.5 2.7 1.7.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.1 1.4Z" />
  </svg>
  <span class="wa-float-label">{t('nav.cta')}</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 99990;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 18px 0 14px;
    border-radius: 999px;
    background: #25D366;
    color: #fff;
    text-decoration: none;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: -.01em;
    box-shadow:
      0 10px 28px -8px rgba(37, 211, 102, .55),
      0 4px 12px -4px rgba(10, 22, 51, .2);
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease,
      opacity .4s ease;
  }

  /* Held out of sight during the desktop hero intro (see Layout.astro's head
     script + HeroStory.astro) so it doesn't clutter the "just the logo" moment. */
  :global(html.intro-pending) .wa-float {
    opacity: 0;
    pointer-events: none;
  }

  .wa-float:hover {
    background: #1ebe57;
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      0 16px 36px -10px rgba(37, 211, 102, .6),
      0 6px 16px -4px rgba(10, 22, 51, .22);
  }

  .wa-float:active {
    transform: translateY(0) scale(0.98);
  }

  .wa-float-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .wa-float-label {
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }

  .wa-float-pulse {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #25D366;
    z-index: 0;
    animation: wa-pulse 2.4s ease-out infinite;
    pointer-events: none;
  }

  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: .45;
    }
    70% {
      transform: scale(1.18);
      opacity: 0;
    }
    100% {
      transform: scale(1.18);
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .wa-float {
      right: 16px;
      bottom: 16px;
      min-height: 52px;
      width: 52px;
      padding: 0;
      justify-content: center;
      border-radius: 50%;
    }

    .wa-float-label {
      display: none;
    }

    .wa-float-icon {
      width: 26px;
      height: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float-pulse {
      animation: none;
      display: none;
    }

    .wa-float {
      transition: none;
    }
  }
</style>
