---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'cardi agent. — AI Agent untuk Operasional Bisnis Indonesia',
  description = 'Cardi Agent membangun tim agen AI yang menangani penjualan, layanan pelanggan, penagihan, dan operasional harian — lintas WhatsApp, email, dan sistem internal Anda.',
  image = '/og-banner.png',
} = Astro.props;

const canonicalURL = Astro.url.href;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cardi Agent',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://aiagent.cardi.co.id',
  description,
  brand: {
    '@type': 'Brand',
    name: 'Cardi',
    url: 'https://cardi.co.id',
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'IDR',
    price: '2999999',
  },
};
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <link rel="icon" type="image/png" href="/icon.png" />
  <link rel="apple-touch-icon" href="/icon.png" />
  <meta name="theme-color" content="#0A1633" />

  <meta property="og:site_name" content="Cardi Agent" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.url)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</head>
<body>
  <div id="boot-screen">
    <div id="boot-line" class="mono">&#9654; exec 00_boot cardi_agent_os v1.0 <span class="accent" id="boot-pct">00%</span></div>
  </div>
  <slot />
  <script>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const boot = document.getElementById('boot-screen');
      const pct = document.getElementById('boot-pct');
      if (!boot) return;
      if (reduced || sessionStorage.getItem('ca_booted')) {
        boot.classList.add('hidden');
        return;
      }
      let n = 0;
      const t = setInterval(() => {
        n += Math.ceil(Math.random() * 22) + 8;
        if (n >= 100) { n = 100; clearInterval(t); }
        if (pct) pct.textContent = String(n).padStart(2, '0') + '%';
        if (n >= 100) {
          setTimeout(() => {
            boot.classList.add('hidden');
            sessionStorage.setItem('ca_booted', '1');
          }, 160);
        }
      }, 60);
      setTimeout(() => {
        boot.classList.add('hidden');
        sessionStorage.setItem('ca_booted', '1');
      }, 1200);
    })();
  </script>
</body>
</html>
