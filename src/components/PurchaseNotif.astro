---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { LangKey } from '../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---
<div id="purchase-notification" class="purchase-notif-box" data-lang={lang}>
  <button class="purchase-notif-close" id="purchaseNotifCloseBtn">&times;</button>
  <div class="purchase-notif-left-stripe"></div>
  <div class="purchase-notif-icon-container">
    <svg class="purchase-notif-bell" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
      <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
    </svg>
  </div>
  <div class="purchase-notif-content">
    <div class="purchase-notif-buyer">
      <span class="buyer-name" id="notifBuyerName">Mua***</span>
      <span class="buyer-email" id="notifBuyerEmail">(mua***@gmail.com)</span>
      <span class="time-ago" id="notifTimeAgo">{t('notif.justNow')}</span>
    </div>
    <div class="purchase-notif-product">
      <span id="notifBoughtLabel">{t('notif.bought')}</span> <span class="product-name" id="notifProductName">Paket Starter Cardi AI Agent</span>,
    </div>
    <div class="purchase-notif-price">
      <span id="notifValuedLabel">{t('notif.valued')}</span> <span class="price-val" id="notifPriceVal">Rp 2.999.999</span>
    </div>
    <div class="purchase-notif-verified">
      <svg class="verified-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span>Transaction Verified by <strong class="verified-provider">Mayar.ID</strong></span>
    </div>
  </div>
</div>

<style>
  .purchase-notif-box {
    position: fixed;
    top: -150px;
    left: 20px;
    width: 380px;
    max-width: calc(100vw - 40px);
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: flex-start;
    padding: 16px 36px 16px 16px;
    z-index: 999999;
    font-family: 'Plus Jakarta Sans', sans-serif;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid rgba(0, 0, 0, 0.08);
    opacity: 0;
    pointer-events: none;
  }
  .purchase-notif-box.show {
    top: 20px;
    opacity: 1;
    pointer-events: auto;
  }
  .purchase-notif-close {
    position: absolute;
    top: 8px;
    right: 12px;
    background: none;
    border: none;
    font-size: 18px;
    color: #aab0c0;
    cursor: pointer;
    line-height: 1;
    padding: 4px;
    transition: color 0.2s;
  }
  .purchase-notif-close:hover {
    color: #333;
  }
  .purchase-notif-left-stripe {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: linear-gradient(180deg, var(--blue), #3E2FE0);
    border-top-left-radius: 16px;
    border-bottom-left-radius: 16px;
  }
  .purchase-notif-icon-container {
    margin-right: 14px;
    margin-top: 2px;
    flex-shrink: 0;
    background: rgba(30, 79, 255, 0.1);
    padding: 10px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(30, 79, 255, 0.2);
  }
  .purchase-notif-bell {
    width: 20px;
    height: 20px;
    color: var(--blue);
  }
  .purchase-notif-content {
    flex-grow: 1;
    text-align: left;
  }
  .purchase-notif-buyer {
    font-size: 13px;
    color: #6b7280;
    margin-bottom: 3px;
    line-height: 1.2;
  }
  .purchase-notif-buyer .buyer-name {
    font-weight: 700;
    color: #111827;
  }
  .purchase-notif-buyer .buyer-email {
    color: #9ca3af;
    margin-left: 2px;
  }
  .purchase-notif-buyer .time-ago {
    color: #c4c9d4;
    margin-left: 4px;
  }
  .purchase-notif-product {
    font-size: 13.5px;
    color: #6b7280;
    line-height: 1.4;
    margin-bottom: 2px;
  }
  .purchase-notif-product .product-name {
    font-weight: 700;
    color: #111827;
  }
  .purchase-notif-price {
    font-size: 13.5px;
    color: #6b7280;
    margin-bottom: 6px;
    line-height: 1.2;
  }
  .purchase-notif-price .price-val {
    font-weight: 700;
    color: #00A87E;
  }
  .purchase-notif-verified {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: #9ca3af;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding-top: 6px;
    margin-top: 4px;
    line-height: 1;
  }
  .verified-icon {
    width: 12px;
    height: 12px;
    color: #00A87E;
  }
  .verified-provider {
    font-weight: 700;
    color: #374151;
  }
</style>

<script>
  const notifContainer = document.getElementById('purchase-notification');
  const currentLang = notifContainer ? notifContainer.getAttribute('data-lang') || 'id' : 'id';

  const buyers = [
    { name: "Mua***", email: "mua***@gmail.com" },
    { name: "And***", email: "and***@gmail.com" },
    { name: "Sya***", email: "sya***@gmail.com" },
    { name: "Bud***", email: "bud***@yahoo.com" },
    { name: "Sit***", email: "sit***@hotmail.com" },
    { name: "Riz***", email: "riz***@gmail.com" },
    { name: "Dew***", email: "dew***@gmail.com" },
    { name: "Hen***", email: "hen***@outlook.com" },
    { name: "Val***", email: "val***@gmail.com" },
    { name: "Jok***", email: "jok***@gmail.com" }
  ];

  const products = [
    { name: "Paket Starter Cardi AI Agent", price: "Rp 2.999.999" },
    { name: "Paket Pro Cardi AI Agent", price: "Rp 7.999.999" },
    { name: "Konsultasi Branding by Cardi Branding", price: "Rp 1.500.000" },
    { name: "GTM Retail Pack by Cardi Nusantara", price: "Rp 4.900.000" }
  ];

  const timeAgos: Record<string, string[]> = {
    id: ["baru saja", "1 menit yang lalu", "2 menit yang lalu", "3 menit yang lalu"],
    en: ["just now", "1 minute ago", "2 minutes ago", "3 minutes ago"],
    zh: ["刚刚", "1分钟前", "2分钟前", "3分钟前"]
  };

  const buyerNameEl = document.getElementById('notifBuyerName');
  const buyerEmailEl = document.getElementById('notifBuyerEmail');
  const productNameEl = document.getElementById('notifProductName');
  const priceValEl = document.getElementById('notifPriceVal');
  const timeAgoEl = document.getElementById('notifTimeAgo');
  const closeBtn = document.getElementById('purchaseNotifCloseBtn');

  let notifTimeout: any = null;
  let nextNotifInterval: any = null;

  function hideNotification() {
    if (notifContainer) notifContainer.classList.remove('show');
  }

  function showRandomNotification() {
    if (!notifContainer) return;
    const buyer = buyers[Math.floor(Math.random() * buyers.length)];
    const product = products[Math.floor(Math.random() * products.length)];
    const list = timeAgos[currentLang] || timeAgos['id'];
    const timeAgo = list[Math.floor(Math.random() * list.length)];

    if (buyerNameEl) buyerNameEl.textContent = buyer.name;
    if (buyerEmailEl) buyerEmailEl.textContent = `(${buyer.email})`;
    if (productNameEl) productNameEl.textContent = product.name;
    if (priceValEl) priceValEl.textContent = product.price;
    if (timeAgoEl) timeAgoEl.textContent = timeAgo;

    notifContainer.classList.add('show');

    if (notifTimeout) clearTimeout(notifTimeout);
    notifTimeout = setTimeout(hideNotification, 6000);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      hideNotification();
      if (nextNotifInterval) clearInterval(nextNotifInterval);
      setTimeout(startNotificationCycle, 45000);
    });
  }

  function startNotificationCycle() {
    if (nextNotifInterval) clearInterval(nextNotifInterval);
    setTimeout(showRandomNotification, 5000);

    nextNotifInterval = setInterval(() => {
      if (Math.random() > 0.3) showRandomNotification();
    }, 18000);
  }

  // While the desktop hero intro is playing (see Layout.astro's head script +
  // HeroStory.astro), hold off the purchase-toast cycle so it doesn't pop up
  // over the "just the logo" moment — start it once the intro reveals the navbar.
  if (document.documentElement.classList.contains('intro-pending')) {
    document.addEventListener('cardi:introDone', startNotificationCycle, { once: true });
  } else {
    startNotificationCycle();
  }
</script>
