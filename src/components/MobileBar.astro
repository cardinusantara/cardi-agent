<div id="mobileBar">
  <div>
    <div class="price mono">Rp 2.999.999<span style="font-weight:500; color:var(--muted); font-size:11px;">/bln</span></div>
    <div class="seats mono">6 slot tersisa</div>
  </div>
  <a class="btn" href="https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20Agent!%20Saya%20ingin%20jadwalkan%20demo%20untuk%20bisnis%20saya.%20%F0%9F%98%81" target="_blank" rel="noopener">Jadwalkan Demo</a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bar = document.getElementById('mobileBar');
    const hero = document.querySelector('.hero');
    if (!bar || !hero) return;
    bar.classList.add('ready');
    const io = new IntersectionObserver(
      ([entry]) => {
        bar.classList.toggle('show', !entry.isIntersecting);
      },
      { threshold: 0 }
    );
    io.observe(hero);
  });
</script>
