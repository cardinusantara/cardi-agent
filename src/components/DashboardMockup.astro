---
const hours = [4, 6, 9, 7, 5, 3, 2, 3, 8, 14, 22, 31, 38, 34, 29, 33, 41, 52, 61, 74, 68, 47, 26, 12];
const peak = Math.max(...hours);
const convos = [
  { name: 'sales-agent', msg: 'penawaran PT Sinar Jaya terkirim', status: 'CLOSED', tone: 'ok' },
  { name: 'support-agent', msg: 'klaim garansi #2291 diproses', status: 'AKTIF', tone: 'live' },
  { name: 'billing-agent', msg: 'invoice #4821 tertagih', status: 'DIBAYAR', tone: 'ok' },
  { name: 'ops-agent', msg: 'nilai di atas batas wewenang', status: 'KE TIM', tone: 'warn' },
];
---

<div class="dash">
  <div class="dash-bar">
    <span class="d"></span><span class="d"></span><span class="d"></span>
    <span class="dash-title">cardi-agent-os · laporan harian</span>
    <span class="dash-live"><span class="dash-pulse"></span>LIVE</span>
  </div>

  <div class="dash-kpis">
    <div class="kpi">
      <div class="kpi-label">Tugas selesai</div>
      <div class="kpi-value">1.284</div>
      <div class="kpi-delta up">▲ 12% vs kemarin</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Tanpa campur tangan</div>
      <div class="kpi-value">91<span class="kpi-unit">%</span></div>
      <div class="kpi-delta up">▲ 8% vs kemarin</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Nilai diproses</div>
      <div class="kpi-value"><span class="kpi-unit">Rp</span>42,6<span class="kpi-unit">jt</span></div>
      <div class="kpi-delta up">▲ 21% vs kemarin</div>
    </div>
  </div>

  <div class="dash-chart">
    <div class="dash-sec-label">Beban kerja per jam <span>puncak 19:00</span></div>
    <div class="bars">
      {hours.map((v, i) => (
        <div class={`bar${v === peak ? ' peak' : ''}`} style={`height:${Math.round((v / peak) * 100)}%`}></div>
      ))}
    </div>
    <div class="bar-axis"><span>00</span><span>06</span><span>12</span><span>18</span><span>23</span></div>
  </div>

  <div class="dash-list">
    <div class="dash-sec-label">Aktivitas agen terakhir</div>
    {convos.map((c) => (
      <div class="convo">
        <span class={`convo-dot ${c.tone}`}></span>
        <span class="convo-name">{c.name}</span>
        <span class="convo-msg">{c.msg}</span>
        <span class={`convo-status ${c.tone}`}>{c.status}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .dash {
    background: #071634;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    overflow: hidden;
    font-family: var(--font-mono);
    color: #fff;
    box-shadow: 0 30px 70px -30px rgba(10, 22, 51, 0.5);
  }

  .dash-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }
  .dash-bar .d { width: 7px; height: 7px; border-radius: 50%; background: rgba(255, 255, 255, 0.16); }
  .dash-title { margin-left: 8px; font-size: 11.5px; color: #7B8AB0; }
  .dash-live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 9.5px; font-weight: 700; letter-spacing: 0.14em; color: #4ADE80; }
  .dash-pulse { width: 6px; height: 6px; border-radius: 50%; background: #4ADE80; animation: dashPulse 1.8s infinite; }
  @keyframes dashPulse {
    0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.55); }
    70% { box-shadow: 0 0 0 5px rgba(74, 222, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }

  .dash-kpis { display: grid; grid-template-columns: repeat(3, 1fr); }
  .kpi { padding: 20px 18px; border-right: 1px solid rgba(255, 255, 255, 0.07); border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
  .kpi:last-child { border-right: none; }
  .kpi-label { font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #6E7DA6; margin-bottom: 10px; }
  .kpi-value { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }
  .kpi-unit { font-size: 13px; font-weight: 500; color: #8FA0C4; }
  .kpi-delta { margin-top: 9px; font-size: 10px; }
  .kpi-delta.up { color: #4ADE80; }

  .dash-sec-label {
    display: flex; justify-content: space-between; align-items: baseline;
    font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #6E7DA6; margin-bottom: 16px;
  }
  .dash-sec-label span { color: #3E80FF; letter-spacing: 0.06em; }

  .dash-chart { padding: 20px 18px; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
  .bars { display: flex; align-items: flex-end; gap: 3px; height: 78px; }
  .bar {
    flex: 1; min-width: 0; border-radius: 2px 2px 0 0;
    background: linear-gradient(to top, rgba(30, 79, 255, 0.35), rgba(62, 128, 255, 0.85));
    transform-origin: bottom;
    animation: barGrow 0.7s cubic-bezier(.16, 1, .3, 1) backwards;
  }
  .bar.peak { background: linear-gradient(to top, rgba(74, 222, 128, 0.4), #4ADE80); }
  @keyframes barGrow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .bar:nth-child(3n) { animation-delay: 0.05s; }
  .bar:nth-child(3n+1) { animation-delay: 0.12s; }
  .bar-axis { display: flex; justify-content: space-between; margin-top: 9px; font-size: 9px; color: #4E5C80; }

  .dash-list { padding: 20px 18px; }
  .convo {
    display: grid; grid-template-columns: 8px auto 1fr auto;
    align-items: center; gap: 10px;
    padding: 9px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .convo:last-child { border-bottom: none; }
  .convo-dot { width: 6px; height: 6px; border-radius: 50%; }
  .convo-dot.ok { background: #4ADE80; }
  .convo-dot.live { background: #3E80FF; }
  .convo-dot.warn { background: #FFB020; }
  .convo-name { font-size: 11.5px; font-weight: 600; color: #E6ECF7; }
  .convo-msg { font-size: 11px; color: #7B8AB0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .convo-status { font-size: 8.5px; font-weight: 700; letter-spacing: 0.1em; padding: 3px 7px; border-radius: 4px; }
  .convo-status.ok { color: #4ADE80; background: rgba(74, 222, 128, 0.12); }
  .convo-status.live { color: #6E9CFF; background: rgba(62, 128, 255, 0.14); }
  .convo-status.warn { color: #FFB020; background: rgba(255, 176, 32, 0.12); }

  @media (max-width: 520px) {
    .dash-kpis { grid-template-columns: 1fr 1fr; }
    .kpi:nth-child(3) { grid-column: span 2; border-right: none; }
    .convo-msg { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar { animation: none; }
    .dash-pulse { animation: none; }
  }
</style>
