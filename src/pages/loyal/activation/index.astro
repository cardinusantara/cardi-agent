---
import Layout from '../../../layouts/Layout.astro';
import TerminalHUD from '../../../components/TerminalHUD.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import MobileBar from '../../../components/MobileBar.astro';

const WA_SUPPORT = 'https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20Support!%20Saya%20butuh%20bantuan%20aktivasi%20kartu%20Cardi%20LoyaL.%20%F0%9F%98%81';
---

<Layout
  title="Aktivasi Kartu Fisik | Cardi LoyaL — Smart Review & Loyalty NFC"
  description="Hubungkan kartu pintar NFC & QR Cardi LoyaL Anda langsung ke profil Google Maps & Review bisnis Anda secara instan dan tanpa ribet."
  image="/logo-cardi-loyal.png"
>
  <TerminalHUD />
  <Nav />

  <main class="activation-page">
    <div class="glow-orb orb-1" aria-hidden="true"></div>
    <div class="glow-orb orb-2" aria-hidden="true"></div>

    <section class="activation-hero">
      <div class="wrap">
        <div class="hero-top-badge mono">
          <span class="live-dot"></span>
          <span>CARDI_LOYAL // NFC_HARDWARE_ACTIVATION_v2.4</span>
        </div>

        <div class="activation-container">
          <!-- SISI KIRI / HEADER INFORMASI -->
          <div class="activation-info">
            <div class="brand-badge">
              <img src="/logo-cardi-loyal.png" alt="Cardi LoyaL" class="loyal-brand-logo" width="36" height="36" />
              <div class="brand-text">
                <span class="brand-name">Cardi LoyaL</span>
                <span class="brand-sub">NFC & QR Smart Review Card</span>
              </div>
            </div>

            <h1 class="hero-title">
              Aktivasi Kartu <span class="gradient-text">Cardi LoyaL</span> Anda
            </h1>

            <p class="hero-desc">
              Hubungkan kartu fisik NFC bisnis Anda langsung ke halaman ulasan Google Maps dalam 1 menit. Setiap kali pelanggan menempelkan (tap) kartu, pop-up rating bintang 5 akan otomatis terbuka di layar smartphone mereka.
            </p>

            <!-- Virtual Card Preview Mockup -->
            <div class="card-mockup-wrapper">
              <div class="nfc-card-mockup" id="cardMockupVisual">
                <div class="card-chip-row">
                  <div class="chip-metal"></div>
                  <div class="nfc-symbol" title="NFC Enabled">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                      <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                    </svg>
                  </div>
                </div>

                <div class="card-brand-row">
                  <img src="/logo-cardi-loyal.png" alt="Cardi LoyaL" class="card-logo-sm" />
                  <span class="card-logo-text">Cardi LoyaL</span>
                </div>

                <div class="card-footer-row">
                  <div>
                    <div class="card-label">ID KARTU</div>
                    <div class="card-code mono" id="previewCardId">#SCAN-READY</div>
                  </div>
                  <div>
                    <div class="card-label">TERHUBUNG KE</div>
                    <div class="card-biz mono" id="previewBizName">Profil Bisnis Anda</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step list summary -->
            <div class="quick-steps">
              <div class="step-item">
                <div class="step-num">01</div>
                <div class="step-text">
                  <strong>Masukkan ID Kartu</strong>
                  <span>Ketik kode ID yang tertera pada kartu atau link aktivasi Anda.</span>
                </div>
              </div>
              <div class="step-item">
                <div class="step-num">02</div>
                <div class="step-text">
                  <strong>Tentukan Profil Bisnis</strong>
                  <span>Ketik nama tempat dan masukkan tautan ulasan Google Maps Anda.</span>
                </div>
              </div>
              <div class="step-item">
                <div class="step-num">03</div>
                <div class="step-text">
                  <strong>Buat PIN & Aktifkan</strong>
                  <span>Simpan PIN keamanan untuk kelola kartu kapan saja di masa depan.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- SISI KANAN / FORM AKTIVASI -->
          <div class="activation-form-card">
            <!-- Header Form -->
            <div class="form-header">
              <div class="form-icon-wrap">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                  <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
              </div>
              <div class="form-title-wrap">
                <h2 class="form-title">Formulir Aktivasi</h2>
                <p class="form-subtitle">Lengkapi formulir di bawah untuk menyelesaikan pairing kartu fisik.</p>
              </div>
            </div>

            <!-- Alert Message Box -->
            <div id="statusAlert" class="status-alert hidden" role="alert">
              <div class="alert-icon" id="alertIcon"></div>
              <div class="alert-msg" id="alertText"></div>
            </div>

            <!-- Main Activation Form -->
            <form id="activationForm" class="form-body" novalidate>
              <!-- Field 1: ID Kartu -->
              <div class="form-group">
                <label for="inputCardId" class="form-label">
                  <span>Kode / ID Kartu Fisik</span>
                  <span class="required-badge">*Wajib</span>
                </label>
                <div class="input-wrap">
                  <span class="input-icon mono">#</span>
                  <input
                    type="text"
                    id="inputCardId"
                    name="cardId"
                    class="form-input mono"
                    placeholder="Contoh: CL-8842 atau scan kartu"
                    required
                    autocomplete="off"
                  />
                </div>
                <span class="field-hint">Otomatis terisi jika membuka tautan dari scan QR pada kartu.</span>
              </div>

              <!-- Field 2: Nama Tempat / Bisnis -->
              <div class="form-group">
                <label for="inputBusinessName" class="form-label">
                  <span>Nama Bisnis / Toko</span>
                  <span class="required-badge">*Wajib</span>
                </label>
                <div class="input-wrap">
                  <span class="input-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                      <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                  </span>
                  <input
                    type="text"
                    id="inputBusinessName"
                    name="businessName"
                    class="form-input"
                    placeholder="Contoh: Kopi Nusantara Menteng"
                    required
                  />
                </div>
              </div>

              <!-- Field 3: Link Google Review -->
              <div class="form-group">
                <label for="inputReviewUrl" class="form-label">
                  <span>Tautan Google Maps / Google Review</span>
                  <span class="required-badge">*Wajib</span>
                </label>
                <div class="input-wrap">
                  <span class="input-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                  </span>
                  <input
                    type="url"
                    id="inputReviewUrl"
                    name="reviewUrl"
                    class="form-input"
                    placeholder="https://g.page/r/... atau https://maps.app.goo.gl/..."
                    required
                  />
                </div>
                <div class="link-helper">
                  <button type="button" id="btnShowTip" class="helper-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="12" y1="16" x2="12" y2="12"></line>
                      <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    Cara dapat link Google Review bisnis saya?
                  </button>
                  <div id="tipBox" class="tip-box hidden">
                    <ol>
                      <li>Buka <strong>Google Maps</strong> dan cari nama tempat usaha Anda.</li>
                      <li>Klik profil bisnis Anda &rarr; pilih menu <strong>"Dapatkan Ulasan Lainnya"</strong> atau <strong>"Minta Ulasan"</strong>.</li>
                      <li>Salin (copy) link ulasan singkat tersebut dan tempelkan ke kolom formulir ini.</li>
                    </ol>
                  </div>
                </div>
              </div>

              <!-- Field 4: PIN Pengelolaan (4 Digit) -->
              <div class="form-group">
                <div class="label-row">
                  <label for="inputPin" class="form-label">
                    <span>Buat PIN Pengaman (4 Digit)</span>
                    <span class="required-badge">*Wajib</span>
                  </label>
                  <span class="pin-count mono" id="pinDigitCounter">0/4</span>
                </div>
                <div class="input-wrap">
                  <span class="input-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                  </span>
                  <input
                    type="password"
                    id="inputPin"
                    name="pin"
                    class="form-input pin-input mono"
                    placeholder="••••"
                    maxlength="4"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    required
                    autocomplete="new-password"
                  />
                  <button type="button" id="btnTogglePin" class="pin-toggle-btn" aria-label="Lihat PIN">
                    <svg id="eyeShowIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg id="eyeHideIcon" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                      <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                  </button>
                </div>
                <span class="field-hint">PIN 4 angka ini disimpan aman untuk mengedit/mengubah link ulasan di masa depan.</span>
              </div>

              <!-- Submit Button -->
              <div class="form-action">
                <button type="submit" id="btnSubmitActivation" class="submit-btn">
                  <span id="btnText">Aktifkan Kartu Sekarang &rarr;</span>
                  <span id="btnSpinner" class="spinner-icon hidden">
                    <svg class="spin-svg" viewBox="0 0 24 24" fill="none">
                      <circle class="spin-track" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="spin-fill" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                  </span>
                </button>
              </div>
            </form>

            <!-- Success State View -->
            <div id="successView" class="success-box hidden">
              <div class="success-badge-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>

              <h3 class="success-title">Kartu Fisik Berhasil Aktif!</h3>
              <p class="success-desc">
                Kartu pintar Anda sekarang telah aktif dan terhubung secara otomatis ke profil ulasan Google Maps bisnis Anda.
              </p>

              <div class="success-details mono">
                <div class="detail-row">
                  <span>ID KARTU:</span>
                  <strong id="resCardId">-</strong>
                </div>
                <div class="detail-row">
                  <span>BISNIS:</span>
                  <strong id="resBizName">-</strong>
                </div>
                <div class="detail-row">
                  <span>STATUS:</span>
                  <span class="active-pill">AKTIF • LIVE</span>
                </div>
              </div>

              <div class="success-actions">
                <a id="btnTestReview" href="#" target="_blank" rel="noopener noreferrer" class="test-review-btn">
                  <span>Uji Coba Tautan Review Sekarang</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
                <button type="button" id="btnResetActivation" class="reset-link-btn">
                  Aktivasi Kartu Lainnya
                </button>
              </div>
            </div>

            <!-- Footer Support -->
            <div class="form-footer-note">
              <span>Butuh bantuan kendala kartu fisik?</span>
              <a href={WA_SUPPORT} target="_blank" rel="noopener" class="support-wa-link">
                Hubungi Support Cardi &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileBar />
</Layout>

<style>
  /* Layout Base */
  .activation-page {
    position: relative;
    padding-top: calc(var(--nav-height, 72px) + 32px);
    padding-bottom: 96px;
    min-height: 100vh;
    background: #0B0F19;
    color: #F8FAFC;
    overflow: hidden;
  }

  /* Decorative Glow Orbs */
  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
  }
  .orb-1 {
    top: -80px;
    right: -80px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(234, 88, 12, 0.22) 0%, rgba(234, 88, 12, 0) 70%);
  }
  .orb-2 {
    bottom: -120px;
    left: -120px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(30, 79, 255, 0.18) 0%, rgba(30, 79, 255, 0) 70%);
  }

  /* Wrap */
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  .hero-top-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.05em;
    color: #94A3B8;
    margin-bottom: 24px;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #EA580C;
    box-shadow: 0 0 10px #EA580C;
    animation: pulse 2s infinite ease-in-out;
  }

  /* Two Column Grid */
  .activation-container {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 960px) {
    .activation-container {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* Left Column */
  .brand-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .loyal-brand-logo {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.06);
    padding: 2px;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-name {
    font-size: 18px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
  }
  .brand-sub {
    font-size: 12px;
    color: #EA580C;
    font-weight: 600;
  }

  .hero-title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin-bottom: 16px;
  }
  .gradient-text {
    background: linear-gradient(135deg, #FF7A00 0%, #EA580C 50%, #FFA84A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 15px;
    line-height: 1.65;
    color: #94A3B8;
    margin-bottom: 28px;
  }

  /* Virtual Card Mockup */
  .card-mockup-wrapper {
    margin-bottom: 32px;
  }
  .nfc-card-mockup {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1.586 / 1;
    border-radius: 20px;
    background: linear-gradient(135deg, #182033 0%, #0F1626 60%, #151D2F 100%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.6), 0 0 30px rgba(234, 88, 12, 0.15);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .nfc-card-mockup:hover {
    transform: translateY(-4px) rotate(-0.5deg);
    box-shadow: 0 24px 50px -10px rgba(0, 0, 0, 0.7), 0 0 40px rgba(234, 88, 12, 0.25);
  }

  .card-chip-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .chip-metal {
    width: 44px;
    height: 32px;
    border-radius: 6px;
    background: linear-gradient(135deg, #D97706 0%, #FBBF24 50%, #B45309 100%);
    border: 1px solid rgba(255, 255, 255, 0.3);
    position: relative;
  }
  .chip-metal::after {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px dashed rgba(0, 0, 0, 0.25);
    border-radius: 3px;
  }
  .nfc-symbol {
    color: rgba(255, 255, 255, 0.6);
  }

  .card-brand-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
  }
  .card-logo-sm {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
  .card-logo-text {
    font-size: 15px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .card-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .card-label {
    font-size: 9px;
    font-weight: 600;
    color: #64748B;
    letter-spacing: 0.06em;
    margin-bottom: 2px;
  }
  .card-code {
    font-size: 13px;
    font-weight: 700;
    color: #F97316;
  }
  .card-biz {
    font-size: 12px;
    font-weight: 600;
    color: #E2E8F0;
    max-width: 160px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Quick Steps */
  .quick-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .step-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .step-num {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    font-weight: 800;
    color: #EA580C;
    background: rgba(234, 88, 12, 0.1);
    border: 1px solid rgba(234, 88, 12, 0.2);
    border-radius: 8px;
    padding: 4px 8px;
    flex-shrink: 0;
  }
  .step-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .step-text strong {
    font-size: 13px;
    color: #FFFFFF;
  }
  .step-text span {
    font-size: 12px;
    color: #94A3B8;
    line-height: 1.5;
  }

  /* Right Column / Form Box */
  .activation-form-card {
    background: rgba(18, 26, 44, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 36px 32px;
    box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
  }

  @media (max-width: 600px) {
    .activation-form-card {
      padding: 24px 20px;
    }
  }

  .form-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .form-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(234, 88, 12, 0.2) 0%, rgba(234, 88, 12, 0.05) 100%);
    border: 1px solid rgba(234, 88, 12, 0.3);
    color: #EA580C;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .form-title {
    font-size: 20px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .form-subtitle {
    font-size: 13px;
    color: #94A3B8;
    margin-top: 2px;
  }

  /* Form Elements */
  .form-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 600;
    color: #E2E8F0;
  }
  .required-badge {
    font-size: 11px;
    font-weight: 500;
    color: #F97316;
  }
  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pin-count {
    font-size: 12px;
