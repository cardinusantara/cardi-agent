  }

  .form-input {
    width: 100%;
    height: 48px;
    padding: 0 16px 0 42px;
    background: rgba(11, 15, 25, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    color: #FFFFFF;
    font-size: 14px;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
