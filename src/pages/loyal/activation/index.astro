  }

  .field-hint {
    font-size: 11px;
    color: #64748B;
    line-height: 1.4;
  }

  /* Link Helper */
  .link-helper {
    margin-top: 4px;
  }
  .helper-btn {
    background: transparent;
    border: none;
    color: #38BDF8;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .helper-btn:hover {
    color: #7DD3FC;
  }
  .tip-box {
    margin-top: 10px;
    padding: 12px 16px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 10px;
    font-size: 12px;
    color: #BAE6FD;
    line-height: 1.6;
  }
  .tip-box ol {
    margin: 0;
    padding-left: 18px;
  }
  .tip-box li {
    margin-bottom: 4px;
  }
  .tip-box li:last-child {
    margin-bottom: 0;
  }

  /* Submit Button */
  .form-action {
    margin-top: 8px;
  }
  .submit-btn {
    width: 100%;
    height: 52px;
    border-radius: 14px;
    border: none;
    background: linear-gradient(135deg, #EA580C 0%, #C2410C 100%);
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 12px 28px -6px rgba(234, 88, 12, 0.4);
    transition: transform 0.15s, box-shadow 0.15s, filter 0.15s;
  }
  .submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 32px -6px rgba(234, 88, 12, 0.5);
    filter: brightness(1.08);
  }
  .submit-btn:active {
    transform: translateY(0);
  }
  .submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }

  /* Spinner */
  .spinner-icon {
    display: inline-flex;
    align-items: center;
  }
  .spin-svg {
    width: 20px;
    height: 20px;
    animation: spin 0.8s linear infinite;
  }
  .spin-track {
    opacity: 0.25;
  }
  .spin-fill {
    opacity: 0.85;
  }

  /* Alert Box */
  .status-alert {
    padding: 12px 16px;
    border-radius: 12px;
    margin-bottom: 20px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
  }
  .status-alert.error {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #FCA5A5;
  }
  .status-alert.success {
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #86EFAC;
  }

  /* Success View */
  .success-box {
    text-align: center;
    padding: 12px 0 8px;
  }
  .success-badge-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.15);
    border: 2px solid rgba(34, 197, 94, 0.4);
    color: #22C55E;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .success-title {
    font-size: 22px;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 8px;
  }
  .success-desc {
    font-size: 14px;
    color: #94A3B8;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .success-details {
    background: rgba(11, 15, 25, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: left;
    font-size: 12px;
  }
  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .detail-row span {
    color: #64748B;
  }
  .detail-row strong {
    color: #F8FAFC;
  }
  .active-pill {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #4ADE80;
    padding: 2px 8px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 11px;
  }

  .success-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .test-review-btn {
    width: 100%;
    height: 48px;
    border-radius: 12px;
    background: #2563EB;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
    transition: background 0.2s;
  }
  .test-review-btn:hover {
    background: #1D4ED8;
  }
  .reset-link-btn {
    background: transparent;
    border: none;
    color: #94A3B8;
    font-size: 13px;
    cursor: pointer;
    text-decoration: underline;
  }
  .reset-link-btn:hover {
    color: #FFFFFF;
  }

  .form-footer-note {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #64748B;
    flex-wrap: wrap;
    gap: 8px;
  }
  .support-wa-link {
    color: #EA580C;
    font-weight: 600;
    text-decoration: none;
  }
  .support-wa-link:hover {
    text-decoration: underline;
  }

  .hidden {
    display: none !important;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes popIn {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('activationForm') as HTMLFormElement | null;
    const cardIdInput = document.getElementById('inputCardId') as HTMLInputElement | null;
    const bizNameInput = document.getElementById('inputBusinessName') as HTMLInputElement | null;
    const reviewUrlInput = document.getElementById('inputReviewUrl') as HTMLInputElement | null;
    const pinInput = document.getElementById('inputPin') as HTMLInputElement | null;
    const pinCounter = document.getElementById('pinDigitCounter');
    const togglePinBtn = document.getElementById('btnTogglePin');
    const eyeShow = document.getElementById('eyeShowIcon');
    const eyeHide = document.getElementById('eyeHideIcon');
    const submitBtn = document.getElementById('btnSubmitActivation') as HTMLButtonElement | null;
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    const statusAlert = document.getElementById('statusAlert');
    const alertText = document.getElementById('alertText');
    const tipBtn = document.getElementById('btnShowTip');
    const tipBox = document.getElementById('tipBox');

    // Visual Preview elements
    const previewCardId = document.getElementById('previewCardId');
    const previewBizName = document.getElementById('previewBizName');

    // Success State elements
    const successView = document.getElementById('successView');
    const resCardId = document.getElementById('resCardId');
    const resBizName = document.getElementById('resBizName');
    const btnTestReview = document.getElementById('btnTestReview') as HTMLAnchorElement | null;
    const btnReset = document.getElementById('btnResetActivation');

    // 1. Check URL parameters for card_id or id
    const urlParams = new URLSearchParams(window.location.search);
    const paramId = urlParams.get('card_id') || urlParams.get('card') || urlParams.get('id') || '';
    if (paramId && cardIdInput) {
      cardIdInput.value = paramId.trim();
      if (previewCardId) previewCardId.textContent = `#${paramId.trim()}`;
    }

    // 2. Dynamic card preview listener
    cardIdInput?.addEventListener('input', () => {
      const val = cardIdInput.value.trim();
      if (previewCardId) {
        previewCardId.textContent = val ? `#${val}` : '#SCAN-READY';
      }
    });

    bizNameInput?.addEventListener('input', () => {
      const val = bizNameInput.value.trim();
      if (previewBizName) {
        previewBizName.textContent = val || 'Profil Bisnis Anda';
      }
    });

    // 3. PIN logic & formatting (4 digits only)
    pinInput?.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      target.value = target.value.replace(/\D/g, '').slice(0, 4);
      if (pinCounter) {
        pinCounter.textContent = `${target.value.length}/4`;
      }
    });

    // 4. Toggle PIN Visibility
    let isPinVisible = false;
    togglePinBtn?.addEventListener('click', () => {
      isPinVisible = !isPinVisible;
      if (pinInput) {
        pinInput.type = isPinVisible ? 'text' : 'password';
      }
      eyeShow?.classList.toggle('hidden', isPinVisible);
      eyeHide?.classList.toggle('hidden', !isPinVisible);
    });

    // 5. Toggle Tip Box
    tipBtn?.addEventListener('click', () => {
      tipBox?.classList.toggle('hidden');
    });

    // 6. Handle Form Submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const cardId = cardIdInput?.value.trim();
      const businessName = bizNameInput?.value.trim();
      let reviewUrl = reviewUrlInput?.value.trim();
      const pin = pinInput?.value.trim();

      // Client validation
      if (!cardId) {
        showAlert('Silakan masukkan ID atau kode kartu Anda.', 'error');
        cardIdInput?.focus();
        return;
      }
      if (!businessName) {
        showAlert('Silakan masukkan nama tempat bisnis Anda.', 'error');
        bizNameInput?.focus();
        return;
      }
      if (!reviewUrl) {
        showAlert('Silakan masukkan tautan Google Review bisnis Anda.', 'error');
        reviewUrlInput?.focus();
        return;
      }
      if (!pin || pin.length !== 4) {
        showAlert('PIN keamanan wajib terdiri dari 4 digit angka.', 'error');
        pinInput?.focus();
        return;
      }

      // Pastikan URL memiliki format http/https
      if (!/^https?:\/\//i.test(reviewUrl)) {
        reviewUrl = `https://${reviewUrl}`;
      }

      // Loading State
      if (submitBtn) submitBtn.disabled = true;
      btnText?.classList.add('hidden');
      btnSpinner?.classList.remove('hidden');
      hideAlert();

      try {
        await new Promise((resolve) => setTimeout(resolve, 800));

        // Simpan ke localStorage
        try {
          const cardKey = `cardi_loyal_card_${cardId}`;
          const cardData = {
            cardId,
            businessName,
            reviewUrl,
            pin,
            activatedAt: new Date().toISOString(),
          };
          localStorage.setItem(cardKey, JSON.stringify(cardData));
        } catch {
          // ignore
        }

        // Show Success
        form?.classList.add('hidden');
        if (successView) {
          successView.classList.remove('hidden');
          if (resCardId) resCardId.textContent = `#${cardId}`;
          if (resBizName) resBizName.textContent = businessName;
          if (btnTestReview) btnTestReview.href = reviewUrl;
        }

        // Update preview card badge to active
        const cardMockup = document.getElementById('cardMockupVisual');
        if (cardMockup) {
          cardMockup.style.boxShadow = '0 20px 40px -10px rgba(0, 0, 0, 0.6), 0 0 35px rgba(34, 197, 94, 0.4)';
          cardMockup.style.borderColor = 'rgba(34, 197, 94, 0.4)';
        }
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : 'Terjadi kendala saat aktivasi.';
        showAlert(msg, 'error');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        btnText?.classList.remove('hidden');
        btnSpinner?.classList.add('hidden');
      }
    });

    // Reset button to activate another
    btnReset?.addEventListener('click', () => {
      form?.reset();
      if (pinCounter) pinCounter.textContent = '0/4';
      if (previewCardId) previewCardId.textContent = '#SCAN-READY';
      if (previewBizName) previewBizName.textContent = 'Profil Bisnis Anda';
      successView?.classList.add('hidden');
      form?.classList.remove('hidden');
      hideAlert();
    });

    function showAlert(msg: string, type: 'error' | 'success') {
      if (!statusAlert || !alertText) return;
      statusAlert.className = `status-alert ${type}`;
      alertText.textContent = msg;
      statusAlert.classList.remove('hidden');
    }

    function hideAlert() {
      if (statusAlert) statusAlert.classList.add('hidden');
    }
  });
</script>
