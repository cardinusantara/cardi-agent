---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<Layout title="Blog" description="Artikel dan insight terbaru">
  <main class="blog-listing">
    <h1>Blog</h1>
    <div class="posts-grid">
      {posts.map((post) => {
        const cleanSlug = (post.data.slug || post.id).replace(/\.mdx?$/, '');
        return (
          <a href={`/${cleanSlug}/`} class="post-card">
            {post.data.cover && <img src={post.data.cover} alt={post.data.title} class="post-cover" />}
            <div class="post-info">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</Layout>

<style>
  .blog-listing {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .blog-listing h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 2rem;
    text-align: center;
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .post-card {
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border, #e5e7eb);
    transition: transform 0.2s, box-shadow 0.2s;
    background: var(--bg-card, #fff);
  }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.08);
  }
  .post-cover {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .post-info {
    padding: 1.25rem;
  }
  .post-info time {
    font-size: 0.8rem;
    color: var(--text-secondary, #888);
  }
  .post-info h2 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0.5rem 0;
    line-height: 1.3;
  }
  .post-info p {
    font-size: 0.9rem;
    color: var(--text-secondary, #666);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
