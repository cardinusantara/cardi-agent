---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import TerminalHUD from '../components/TerminalHUD.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import DashboardMockup from '../components/DashboardMockup.astro';

const WA = 'https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20Agent!%20Saya%20ingin%20jadwalkan%20demo%20untuk%20bisnis%20saya.%20%F0%9F%98%81';
---

<Layout>
  <AnnouncementBar />
  <Nav />
  <TerminalHUD />

  <!-- 02. HERO -->
  <section class="hero grid-bg" data-exec="00_boot.init">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-pill mono">
          <span class="pulse-dot"></span> AI Agent untuk Bisnis · Ekosistem Cardi · Live 2026
        </div>
        <h1>
          Pekerjaan yang menghabiskan<br />
          <span class="em" data-scramble>hari tim Anda,</span><br />
          dikerjakan agen AI.
        </h1>
        <p class="hero-sub">
          Cardi Agent membangun tim agen AI yang menangani penjualan, layanan pelanggan, penagihan, dan operasional harian — di WhatsApp, Instagram, email, sampai sistem internal Anda. Bukan satu chatbot, tapi <span class="hl">satu sistem yang menjalankan bisnisnya</span>.
        </p>
        <div class="heroCta">
          <a class="btn" href={WA} target="_blank" rel="noopener">Jadwalkan Demo Gratis →</a>
          <a class="link-arrow" href="#cara-kerja">Lihat sistemnya jalan ↓</a>
        </div>
        <div class="hero-note mono">
          Belum yakin? <a href={WA} target="_blank" rel="noopener">Minta audit alur kerja gratis 30 menit →</a>
        </div>
      </div>

      <div class="hero-canvas-wrap">
        <canvas id="chipCanvas" aria-label="Diagram arsitektur Cardi Agent" role="img"></canvas>
      </div>
    </div>
  </section>

  <!-- 03. PIXEL MATRIX BAND -->
  <div class="pixel-band" data-exec="01_engine.render">
    <canvas id="pixelCanvas" aria-hidden="true"></canvas>
    <div class="pixel-caption mono">
      <div class="big" id="pixelCount">0</div>
      <div class="small">tugas diselesaikan agen bulan ini</div>
    </div>
  </div>

  <!-- 04. PROBLEM -->
  <section id="masalah" data-exec="02_masalah.diagnose">
    <div class="wrap">
      <div class="eyebrow">Diagnosa</div>
      <h2 class="h2">Bukan bisnis Anda yang salah. <span class="dim">Sistemnya yang hilang.</span></h2>

      <div class="problem-grid">
        <div class="problem-lines reveal">
          <p>Permintaan masuk dari lima kanal berbeda, dicatat di lima tempat berbeda.</p>
          <p>Tim Anda menghabiskan separuh hari untuk pekerjaan yang persis sama setiap hari.</p>
          <p>Calon pelanggan bertanya malam hari, dibalas besok pagi — kalau tidak terlewat.</p>
          <p>Penawaran yang sudah dikirim tidak pernah di-follow-up karena semua orang sibuk.</p>
          <p>Invoice jatuh tempo lewat seminggu sebelum ada yang sadar.</p>
          <p>Data berubah di satu sistem, sistem lain masih memakai angka lama.</p>
          <p>Setiap karyawan baru butuh sebulan sebelum paham cara kerja internal Anda.</p>
          <p>Laporan bulanan disusun manual, dan baru siap saat keputusannya sudah telat.</p>
          <p class="strong">Anda tidak butuh lebih banyak orang untuk pekerjaan ini. Anda butuh <span class="hl">satu sistem yang menjalankannya sendiri.</span></p>
        </div>

        <div class="reveal">
          <div class="diagram-label"><span>› Hari ini</span><span>8 TEMPAT</span></div>
          <div class="scatter" id="scatter">
            <svg viewBox="0 0 400 150" preserveAspectRatio="none" aria-hidden="true">
              <line x1="70" y1="30" x2="200" y2="18" stroke="#6B7A9C" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"></line>
              <line x1="70" y1="30" x2="90" y2="78" stroke="#6B7A9C" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"></line>
              <line x1="240" y1="80" x2="150" y2="125" stroke="#6B7A9C" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"></line>
              <line x1="240" y1="80" x2="310" y2="128" stroke="#6B7A9C" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"></line>
              <text x="132" y="27" fill="#EF4444" font-size="11" font-family="monospace">✕</text>
              <text x="196" y="106" fill="#EF4444" font-size="11" font-family="monospace">✕</text>
            </svg>
            <span class="chip" style="left:0%; top:10%;">WHATSAPP</span>
            <span class="chip" style="left:47%; top:0%;">SPREADSHEET</span>
            <span class="chip" style="left:8%; top:45%;">EMAIL</span>
            <span class="chip" style="left:55%; top:42%;">CRM</span>
            <span class="chip" style="left:22%; top:78%;">GRUP INTERNAL</span>
            <span class="chip" style="left:68%; top:80%;">PEMBUKUAN</span>
          </div>
          <div class="diagram-caption">Tidak ada yang saling terhubung</div>

          <div class="diagram-arrow">↓</div>

          <div class="diagram-label"><span>› Dengan sebuah OS</span><span>1 SISTEM</span></div>
          <div class="tree-window">
            <div class="tree-title"><span class="dot"></span> cardi-agent-os/</div>
            <div class="tree-row"><span class="box"></span> kanal/ <span class="rule"></span></div>
            <div class="tree-row"><span class="box"></span> agen/ <span class="rule"></span></div>
            <div class="tree-row"><span class="box"></span> data/ <span class="rule"></span></div>
            <div class="tree-row"><span class="box"></span> kendali/ <span class="rule"></span></div>
          </div>
          <div class="diagram-caption">Satu sistem · semua terhubung</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05. LIVE DEMO -->
  <section id="cara-kerja" class="grid-bg soft" data-exec="03_sistem.render">
    <div class="wrap">
      <div class="eyebrow">Live demo</div>
      <h2 class="h2">Lihat sistemnya jalan, <span class="dim">bukan cuma slide.</span></h2>
      <p class="sub">Ini bukan diagram. Ini graf pengetahuan yang benar-benar berjalan — 25 komponen, 41 relasi. Tarik node-nya, geser kanvasnya, klik untuk lihat tugas masing-masing.</p>

      <div class="kg reveal">
        <div class="demo-topbar mono">
          <span class="demo-dot"></span><span class="demo-dot"></span><span class="demo-dot"></span>
          <span style="margin-left:8px;">cardi-agent-os · knowledge graph</span>
          <span class="live-badge"><span class="pulse-dot"></span> LIVE</span>
        </div>

        <div class="kg-stage">
          <canvas id="kgCanvas"></canvas>

          <div class="kg-legend" id="kgLegend"></div>

          <div class="kg-controls">
            <button class="kg-btn" id="kgZoomOut" aria-label="Perkecil">−</button>
            <button class="kg-btn" id="kgZoomIn" aria-label="Perbesar">+</button>
            <button class="kg-btn wide" id="kgReset">RESET</button>
          </div>

          <div class="kg-hint mono">tarik node · geser kanvas · klik untuk detail</div>

          <div class="kg-panel" id="kgPanel">
            <button class="kg-panel-close" id="kgPanelClose" aria-label="Tutup">✕</button>
            <div class="kg-panel-tag"><span class="sw" id="kgPanelSw"></span><span id="kgPanelGroup"></span></div>
            <h5 id="kgPanelTitle"></h5>
            <p id="kgPanelDesc"></p>
            <div class="kg-panel-links" id="kgPanelLinks"></div>
          </div>
        </div>

        <div class="demo-footer mono">
          <span>$ os graph --live</span>
          <span class="accent">25 node · 41 relasi · milik Anda sejak hari pertama</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 06. TRANSPARENCY -->
  <section class="transparency" data-exec="04_bukti.open">
    <div class="wrap center">
      <p>Cek sendiri sistemnya sebelum bayar. Kami jalankan demo memakai kasus nyata dari bisnis Anda — bukan video rekaman, bukan slide.</p>
      <a class="link-arrow" style="color:#8FA6FF;" href="https://cardi.co.id/" target="_blank" rel="noopener">Lihat ekosistem Cardi →</a>
    </div>
  </section>

  <!-- 07. ORIGIN STORY -->
  <section id="cerita" data-exec="05_origin.introduce">
    <div class="wrap">
      <div class="eyebrow">Kenapa ini dibangun</div>
      <h2 class="h2">Kami capek lihat tim pintar <span class="dim">mengerjakan hal yang sama tiap hari.</span></h2>

      <div class="founder-grid">
        <div class="founder-copy reveal">
          <p>Cardi mulai dari tim yang ikut menjalankan operasional klien sendiri — bantu jualan, bantu follow-up, bantu rapikan laporan. Kami tahu persis rasanya kehabisan tangan sebelum kehabisan peluang.</p>
          <p>Jadi kami bangun sistemnya untuk dipakai sendiri dulu: beberapa agen AI yang menangani permintaan masuk, menyusun penawaran, menagih, dan menyiapkan laporan — tanpa perlu ditunggui.</p>
          <p>Setelah dipakai internal, waktu respons rata-rata turun ke <b class="ul">1,8 detik</b> dan konversi naik <b class="ul">58%</b>. Baru setelah itu kami buka untuk bisnis lain lewat Cardi Agent.</p>
        </div>

        <div class="reveal">
          <h3 style="font-size:20px; font-weight:700; letter-spacing:-0.02em; margin-bottom:18px;">Bayangkan 30 hari dari sekarang.</h3>
          <div class="timeline-item"><div class="timeline-time mono">SEMALAMAN</div><div class="timeline-text">Agen menangani setiap permintaan yang masuk sambil Anda tidur — tanpa satu pun menunggu pagi.</div></div>
          <div class="timeline-item"><div class="timeline-time mono">07:00</div><div class="timeline-text">Ringkasan semalam dan status pipeline masuk ke grup internal, otomatis.</div></div>
          <div class="timeline-item"><div class="timeline-time mono">07:05</div><div class="timeline-text">Anda baca dashboard 2 menit sambil ngopi — tahu apa yang perlu diputuskan hari ini.</div></div>
          <div class="timeline-item"><div class="timeline-time mono">09:00</div><div class="timeline-text">Tim mulai kerja dari pekerjaan yang benar-benar butuh manusia — sisanya sudah beres.</div></div>
          <div class="timeline-item"><div class="timeline-time mono">SETELAH ITU</div><div class="timeline-text">Jam yang biasanya habis untuk pekerjaan berulang, dipakai untuk produk dan strategi.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 08. MECHANISM: 4 LAYERS -->
  <section id="fitur" class="grid-bg soft" data-exec="06_arsitektur.layers">
    <div class="wrap">
      <div class="eyebrow">Arsitektur</div>
      <h2 class="h2">Empat lapisan yang bekerja sama, <span class="dim">bukan empat aplikasi terpisah.</span></h2>

      <div class="layer-grid">
        <div class="layer-card card reveal">
          <div class="layer-tag mono"><b>LAYER 01</b><span>APA YANG DIKETAHUI</span></div>
          <h3>Konteks</h3>
          <p><b>Bisnis Anda, dikodekan.</b> Produk, harga, SOP, dokumen internal, dan gaya bicara perusahaan jadi satu basis pengetahuan yang dipakai semua agen.</p>
          <div class="layer-example mono">Example: agen mengutip <b>syarat garansi</b> langsung dari kontrak Anda, bukan mengarang.</div>
        </div>
        <div class="layer-card card reveal">
          <div class="layer-tag mono"><b>LAYER 02</b><span>SIAPA YANG MENGERJAKAN</span></div>
          <h3>Agen</h3>
          <p><b>Pekerja AI dengan nama dan tugas.</b> Bukan satu bot serba bisa, tapi beberapa agen yang masing-masing menangani satu pekerjaan sampai tuntas.</p>
          <div class="layer-example mono">Example: <b>sales-agent</b> mengejar closing, <b>billing-agent</b> menagih, keduanya jalan bersamaan.</div>
        </div>
        <div class="layer-card card reveal">
          <div class="layer-tag mono"><b>LAYER 03</b><span>APA YANG BISA DILAKUKAN</span></div>
          <h3>Aksi</h3>
          <p><b>Bukan cuma menjawab, tapi bertindak.</b> Agen terhubung ke sistem Anda, jadi bisa menerbitkan invoice, update stok, dan mencatat order sungguhan.</p>
          <div class="layer-example mono">Example: order disetujui → invoice terbit → tercatat di pembukuan, <b>tanpa entri manual</b>.</div>
        </div>
        <div class="layer-card card reveal">
          <div class="layer-tag mono"><b>LAYER 04</b><span>SIAPA YANG PEGANG KENDALI</span></div>
          <h3>Kendali</h3>
          <p><b>Anda tetap memegang kemudi.</b> Setiap tindakan tercatat, batasnya Anda yang tentukan, dan pekerjaan bernilai besar selalu dilempar ke manusia dulu.</p>
          <div class="layer-example mono">Example: transaksi di atas <b>Rp 50 juta</b> wajib disetujui tim sebelum agen lanjut.</div>
        </div>
      </div>
      <p class="thesis"><b>Kuasai empat lapisan ini dan Anda memiliki sistemnya, bukan menyewanya.</b> Model AI akan berganti, tools akan berganti — arsitektur ini tetap milik Anda.</p>
    </div>
  </section>

  <!-- 09. FOLDER BROWSER -->
  <section id="untuk-siapa" data-exec="07_persona.browse">
    <div class="wrap">
      <div class="eyebrow">Personas</div>
      <h2 class="h2">Setiap bisnis dikirim sebagai satu tim. <span class="dim">Buka foldernya, lihat rosternya.</span></h2>

      <div class="browser-shell reveal">
        <div class="browser-side" id="browserSide">
          <div class="browser-folder active" data-persona="fnb">▸ retail-ecommerce.</div>
          <div class="browser-folder" data-persona="fashion">▸ jasa-profesional.</div>
          <div class="browser-folder" data-persona="jasa">▸ distribusi-b2b.</div>
          <div class="browser-folder" data-persona="enterprise">▸ enterprise.</div>
        </div>
        <div class="browser-main">
          <div class="browser-roster-title" id="browserRosterTitle">ROSTER · retail-ecommerce.</div>
          <div class="browser-roster" id="browserRoster">
            <span class="roster-chip">sales-agent</span>
            <span class="roster-chip">support-agent</span>
            <span class="roster-chip">billing-agent</span>
            <span class="roster-chip">stock-sync-agent</span>
            <span class="roster-chip">review-agent</span>
          </div>

          <div class="anatomy-grid">
            <div class="anatomy-col">
              <h4>01 · Root spine</h4>
              <li>▭ reasoning-engine</li>
              <li>▭ basis-pengetahuan</li>
              <li>▭ sop-bisnis</li>
            </div>
            <div class="anatomy-col">
              <h4>02 · Blocks</h4>
              <li>▦ kanal-masuk</li>
              <li>▦ katalog-data</li>
              <li>▦ integrasi-sistem</li>
            </div>
            <div class="anatomy-col">
              <h4>03 · Agents</h4>
              <li>◦ sales-agent</li>
              <li>◦ support-agent</li>
              <li>◦ billing-agent</li>
              <li>◦ ops-agent</li>
            </div>
            <div class="anatomy-col">
              <h4>04 · Skills</h4>
              <li>✓ kualifikasi-lead</li>
              <li>✓ susun-penawaran</li>
              <li>✓ tagih-otomatis</li>
              <li>✓ ringkasan-harian</li>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. ONBOARDING ACCORDION -->
  <section class="grid-bg soft" data-exec="08_onboarding.plan">
    <div class="wrap">
      <div class="eyebrow">Proses</div>
      <h2 class="h2">Enam langkah, <span class="dim">dari kontrak sampai live.</span></h2>
      <p class="acc-intro">6 tahap · dijalankan tim Cardi bersama Anda · live dalam 7–14 hari kerja</p>

      <div id="accOnboard">
        <div class="acc-item open">
          <button class="acc-head" type="button" aria-expanded="true"><span><span class="num mono">01</span><h4>Kickoff &amp; audit alur kerja</h4></span><span class="acc-toggle">−</span></button>
          <div class="acc-body"><div class="acc-body-inner">
            <ul>
              <li>Sesi 60 menit memetakan proses mana yang paling menyita waktu tim</li>
              <li>Tentukan agen apa saja yang dibangun lebih dulu, dan urutannya</li>
              <li>Kumpulkan SOP, daftar produk atau layanan, dan dokumen internal</li>
              <li>Sepakati batas wewenang agen dan kapan harus lempar ke manusia</li>
              <li>+1 lagi, dibahas langsung saat sesi</li>
            </ul>
            <div class="acc-footer">Anda keluar sesi ini dengan — <b>peta proses dan daftar agen yang siap dibangun.</b></div>
          </div></div>
        </div>
        <div class="acc-item"><button class="acc-head" type="button" aria-expanded="false"><span><span class="num mono">02</span><h4>Sambungkan kanal &amp; sistem Anda</h4></span><span class="acc-toggle">+</span></button><div class="acc-body"><div class="acc-body-inner"><ul><li>Hubungkan WhatsApp Business API resmi, Instagram, email, atau form web</li><li>Integrasikan spreadsheet, CRM, atau ERP yang sudah tim Anda pakai</li></ul></div></div></div>
        <div class="acc-item"><button class="acc-head" type="button" aria-expanded="false"><span><span class="num mono">03</span><h4>Bangun basis pengetahuan</h4></span><span class="acc-toggle">+</span></button><div class="acc-body"><div class="acc-body-inner"><ul><li>Import katalog, harga, kontrak, dan dokumen internal</li><li>Kodekan SOP perusahaan jadi aturan yang dipatuhi setiap agen</li></ul></div></div></div>
        <div class="acc-item"><button class="acc-head" type="button" aria-expanded="false"><span><span class="num mono">04</span><h4>Latih &amp; uji coba internal</h4></span><span class="acc-toggle">+</span></button><div class="acc-body"><div class="acc-body-inner"><ul><li>Tim Anda uji agen dengan kasus nyata dari arsip sendiri</li><li>Kalibrasi nada bicara dan batas keputusan sampai pas</li></ul></div></div></div>
        <div class="acc-item"><button class="acc-head" type="button" aria-expanded="false"><span><span class="num mono">05</span><h4>Soft launch pada satu proses</h4></span><span class="acc-toggle">+</span></button><div class="acc-body"><div class="acc-body-inner"><ul><li>Satu agen dijalankan lebih dulu di sebagian beban kerja</li><li>Dipantau bareng tim Cardi selama 3–5 hari sebelum diperluas</li></ul></div></div></div>
        <div class="acc-item"><button class="acc-head" type="button" aria-expanded="false"><span><span class="num mono">06</span><h4>Go live penuh &amp; serah terima kendali</h4></span><span class="acc-toggle">+</span></button><div class="acc-body"><div class="acc-body-inner"><ul><li>Seluruh agen aktif menangani beban kerja harian</li><li>Tim Anda dilatih membaca dashboard dan mengatur agen sendiri</li></ul></div></div></div>
      </div>
    </div>
  </section>

  <!-- 11. DELIVERABLES -->
  <section data-exec="09_deliver.list">
    <div class="wrap">
      <div class="eyebrow">Yang Anda dapat</div>
      <h2 class="h2">Bukan sekadar akses. <span class="dim">Sistem yang jadi milik Anda.</span></h2>

      <div class="deliv-grid">
        <div class="deliv-card card"><div class="deliv-kicker">Tim agen</div><h3>Agen dengan nama dan tugas.</h3><p>Dibangun untuk proses Anda sendiri, bukan template generik yang dipakai ulang semua klien.</p></div>
        <div class="deliv-card card"><div class="deliv-kicker">Live · onboarding 6 tahap</div><h3>Dilatih dengan data Anda.</h3><p>Produk, harga, SOP, dan gaya bicara perusahaan jadi basis pengetahuan yang dipakai setiap agen.</p></div>
        <div class="deliv-card card"><div class="deliv-kicker">Kanal &amp; integrasi</div><h3>Nyambung ke sistem yang ada.</h3><p>WhatsApp resmi, Instagram, email, form web, plus spreadsheet, CRM, atau ERP yang sudah Anda pakai.</p></div>
        <div class="deliv-card card"><div class="deliv-kicker">Dashboard &amp; laporan</div><h3>Laporan otomatis tiap pagi.</h3><p>Pipeline, konversi, dan beban kerja dikirim ke tim tanpa perlu ada yang menyusunnya manual.</p></div>
        <div class="deliv-card card"><div class="deliv-kicker">Kendali &amp; audit</div><h3>Setiap tindakan tercatat.</h3><p>Anda menentukan batas wewenang agen, dan bisa menelusuri kembali apa yang dikerjakan serta alasannya.</p></div>
        <div class="deliv-card card"><div class="deliv-kicker">Priority support</div><h3>Tim manusia tetap siaga.</h3><p>Saat agen ragu, pekerjaan diteruskan ke tim Anda — tidak pernah dibiarkan menggantung.</p></div>

        <div class="deliv-card card deliv-wide">
          <div style="flex:1; min-width:260px;">
            <div class="deliv-kicker">Kepemilikan</div>
            <h3>Data dan basis pengetahuan tetap milik Anda.</h3>
            <p>Bisa diekspor kapan saja. Berhenti berlangganan pun, apa yang sudah dibangun tidak ikut hilang bersama akun.</p>
          </div>
          <div style="flex:1; min-width:260px; padding-top:34px;">
            <p style="font-size:14px; color:var(--body); line-height:1.75;">Dan satu hal terakhir yang bukan berupa file: <b class="hl">tim Anda jadi paham cara mengatur dan menambah agen sendiri</b> — bukan tergantung selamanya pada kami.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 12. TOOLS CAROUSEL -->
  <section class="grid-bg soft" data-exec="10_integrasi.connect">
    <div class="wrap">
      <div class="eyebrow">Integrasi</div>
      <h2 class="h2">Cardi Agent tidak menggantikan tools Anda. <span class="dim">Ia menghubungkannya.</span></h2>

      <div class="carousel-wrap">
        <div class="carousel-track" id="toolTrack">
          <div class="tool-card card"><div class="tool-index mono">01 / 06</div><h4>whatsapp-business-api.</h4><p>Kanal resmi tempat agen menjawab, menawarkan, dan menagih pelanggan Anda.</p><div class="tool-tags"><span class="tool-tag">kanal</span><span class="tool-tag">populer</span></div></div>
          <div class="tool-card card"><div class="tool-index mono">02 / 06</div><h4>email-inbox.</h4><p>Inbox penjualan dan support dibaca, diklasifikasi, lalu dibalas atau diteruskan.</p><div class="tool-tags"><span class="tool-tag">kanal</span><span class="tool-tag">opsional</span></div></div>
          <div class="tool-card card"><div class="tool-index mono">03 / 06</div><h4>sheets-crm.</h4><p>Sinkron dua arah dengan spreadsheet atau CRM yang sudah tim Anda pakai.</p><div class="tool-tags"><span class="tool-tag">data</span><span class="tool-tag">opsional</span></div></div>
