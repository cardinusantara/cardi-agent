      color: rgba(255, 255, 255, 0.85);
      font-size: 14.5px;
      max-width: 540px;
      margin: 0;
    }

    /* Footer - Aligned with Cardi Brand Ecosystem */
    footer {
      background: #FFFFFF;
      border-top: 1px solid var(--line);
      padding: 56px 0 24px;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr repeat(3, 1fr);
      gap: 40px;
      margin-bottom: 40px;
    }
    .footer-brand p {
      font-size: 12.5px;
      color: var(--muted);
      line-height: 1.65;
      margin: 14px 0 16px;
      max-width: 320px;
    }
    .footer-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 6px;
      background: var(--soft);
      border: 1px solid var(--line);
      font-size: 11px;
      font-weight: 700;
      color: var(--ink);
    }
    .footer-col h4 {
      font-size: 13.5px;
      margin-bottom: 16px;
      color: var(--ink);
    }
    .footer-col ul {
      list-style: none;
    }
    .footer-col li {
      margin-bottom: 10px;
    }
    .footer-col a {
      font-size: 12.5px;
      color: var(--muted);
    }
    .footer-col a:hover {
      color: var(--blue);
    }
    .copyright-bar {
      border-top: 1px solid var(--line);
      padding-top: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      color: var(--muted);
    }

    /* Floating WhatsApp Button */
    .wa-float {
      position: fixed;
      right: 24px;
      bottom: 24px;
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: #25D366;
      color: #FFFFFF;
      display: grid;
      place-items: center;
      font-size: 26px;
      border: none;
      box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
      cursor: pointer;
      z-index: 1000;
      transition: all 0.25s ease;
    }
    .wa-float:hover {
      transform: scale(1.1);
      box-shadow: 0 12px 30px rgba(37, 211, 102, 0.5);
    }
    .wa-tooltip {
      position: fixed;
      right: 88px;
      bottom: 34px;
      background: var(--ink);
      color: #FFFFFF;
      font-size: 12px;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 8px;
      box-shadow: var(--shadow-soft);
      pointer-events: none;
      z-index: 1000;
      white-space: nowrap;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 32px 0;
      }
      .feature-strip {
        grid-template-columns: repeat(2, 1fr);
      }
      .usecase-card {
        flex: 0 0 calc((100% - 16px) / 2);
      }
      .workflow-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .price-grid {
        grid-template-columns: 1fr;
      }
      .price-card.featured {
        transform: none;
      }
      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 768px) {
      .eco-bar { display: none; }
      .nav-links { display: none; }
      .btn-main-site { display: none; }
      .section-head {
        flex-direction: column;
        align-items: flex-start;
      }
      .feature-strip {
        grid-template-columns: 1fr;
      }
      .usecase-card {
        flex: 0 0 100%;
      }
      .workflow {
        padding: 28px 20px;
      }
      .workflow-grid {
        grid-template-columns: 1fr;
      }
      .bottom-cta {
        flex-direction: column;
        text-align: center;
        padding: 32px 20px;
      }
      .footer-grid {
        grid-template-columns: 1fr;
      }
      .copyright-bar {
        flex-direction: column;
        gap: 8px;
        text-align: center;
      }
      .meeting-body {
        grid-template-columns: 1fr;
      }
      .side-panel {
        border-left: 0;
        border-top: 1px solid var(--line);
      }
    }
  </style>
</head>
