    .flow-card:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(100, 181, 246, 0.4);
      transform: translateY(-3px);
    }
    .flow-card .num {
      font-size: 11px;
      font-weight: 800;
      color: #64B5F6;
      letter-spacing: 0.05em;
      margin-bottom: 12px;
    }
    .flow-card i {
      font-size: 22px;
      color: #FFFFFF;
      margin-bottom: 12px;
      display: block;
    }
    .flow-card h3 {
      font-size: 15px;
      color: #FFFFFF;
      margin-bottom: 8px;
    }
    .flow-card p {
      font-size: 12px;
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.7);
      margin: 0;
    }

    /* Pricing Section */
    .pricing {
      padding: 72px 0;
      background: linear-gradient(180deg, #FFFFFF 0%, var(--soft) 100%);
    }
    .pricing-head {
      text-align: center;
      max-width: 620px;
      margin: 0 auto 48px;
    }
    .pricing-head p {
      color: var(--body);
      font-size: 14.5px;
      margin-top: 8px;
    }
    .price-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      align-items: stretch;
    }
    .price-card {
      background: #FFFFFF;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 32px 28px;
      box-shadow: var(--shadow-soft);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      transition: all 0.25s ease;
    }
    .price-card:hover {
      box-shadow: var(--shadow-hover);
      transform: translateY(-3px);
    }
    .price-card.featured {
      border: 2px solid var(--blue);
      box-shadow: 0 16px 40px rgba(2, 88, 164, 0.14);
      transform: scale(1.02);
    }
    .price-card.featured:hover {
      transform: scale(1.02) translateY(-3px);
    }
    .popular {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--blue);
      color: #FFFFFF;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      padding: 4px 12px;
      border-radius: 999px;
      box-shadow: 0 4px 12px rgba(2, 88, 164, 0.3);
    }
    .price-card h3 {
      font-size: 20px;
      margin-bottom: 4px;
    }
    .price-card > p {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 20px;
    }
    .price {
      font-size: 32px;
      font-weight: 900;
      color: var(--ink);
      letter-spacing: -0.03em;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--line);
      padding-bottom: 16px;
    }
    .price small {
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
    }
    .price-list {
      list-style: none;
      margin-bottom: 28px;
      flex: 1;
    }
    .price-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--body);
      margin-bottom: 12px;
    }
    .price-list li i {
      color: #00A87E;
      font-size: 12px;
    }

    /* FAQ Section */
    .faq-item {
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      margin-bottom: 12px;
      background: #FFFFFF;
      overflow: hidden;
    }
    .faq-button {
      width: 100%;
      padding: 18px 22px;
      background: none;
      border: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14.5px;
      font-weight: 700;
      color: var(--ink);
      cursor: pointer;
      text-align: left;
      font-family: inherit;
    }
