  <script is:inline>
    const WHATSAPP_NUMBER = "6281289895646";
    const waMessages = {
      demo: "Halo Cardi Agent MoM, saya tertarik untuk melihat demo langsung produk AI Meeting Intelligence. Bisa bantu jadwalkan sesi demo?",
      starter: "Halo Cardi Agent MoM, saya tertarik dengan paket Starter Rp 99.000/bulan. Bisa jelaskan detail aktivasi akunnya?",
      business: "Halo Cardi Agent MoM, saya ingin berkonsultasi mengenai paket Business Rp 599.000/bulan untuk tim kami.",
      enterprise: "Halo Cardi Agent MoM, kami ingin berdiskusi mengenai paket Enterprise dan integrasi kustom ke sistem perusahaan kami.",
      general: "Halo Cardi Agent MoM, saya ingin mengetahui informasi lebih lanjut mengenai solusi AI Meeting Intelligence."
    };

    function openWhatsApp(topic = "general") {
      const message = waMessages[topic] || waMessages.general;
      const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
      window.open(url, "_blank", "noopener,noreferrer");
    }

    // Carousel Logic
    const track = document.getElementById("usecaseTrack");
    const cards = Array.from(track.children);
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const dotsWrap = document.getElementById("carouselDots");
    let currentIndex = 0;
    let autoTimer = null;

    function getVisibleSlides() {
      if (window.innerWidth <= 768) return 1;
      if (window.innerWidth <= 1024) return 2;
      return 4;
    }

    function getGap() {
      const style = getComputedStyle(track);
      return parseFloat(style.columnGap || style.gap || 16);
    }

    function getMaxIndex() {
      return Math.max(0, cards.length - getVisibleSlides());
    }

    function buildDots() {
      dotsWrap.innerHTML = "";
      const maxIndex = getMaxIndex();
      const totalDots = maxIndex + 1;
      for (let i = 0; i < totalDots; i++) {
        const dot = document.createElement("button");
        if (i === currentIndex) dot.classList.add("active");
        dot.addEventListener("click", () => {
          currentIndex = i;
          updateCarousel();
          resetAuto();
        });
        dotsWrap.appendChild(dot);
      }
    }

    function updateCarousel() {
      const visible = getVisibleSlides();
      const maxIndex = getMaxIndex();
      currentIndex = Math.min(currentIndex, maxIndex);

      const cardWidth = cards[0].getBoundingClientRect().width;
      const offset = currentIndex * (cardWidth + getGap());
      track.style.transform = `translateX(-${offset}px)`;

      cards.forEach((card, idx) => {
        card.classList.toggle("active", idx >= currentIndex && idx < currentIndex + visible);
      });

      Array.from(dotsWrap.children).forEach((dot, idx) => {
        dot.classList.toggle("active", idx === currentIndex);
      });
    }

    function nextSlide() {
      const maxIndex = getMaxIndex();
      if (currentIndex >= maxIndex) {
        currentIndex = 0;
      } else {
        currentIndex += 1;
      }
      updateCarousel();
    }

    function prevSlide() {
      const maxIndex = getMaxIndex();
      if (currentIndex <= 0) {
        currentIndex = maxIndex;
      } else {
        currentIndex -= 1;
      }
      updateCarousel();
    }

    function resetAuto() {
      clearInterval(autoTimer);
      autoTimer = setInterval(nextSlide, 5000);
    }

    prevBtn.addEventListener("click", () => {
      prevSlide();
      resetAuto();
    });

    nextBtn.addEventListener("click", () => {
      nextSlide();
      resetAuto();
    });

    window.addEventListener("resize", () => {
      buildDots();
      updateCarousel();
    });

    document.querySelector(".carousel-shell").addEventListener("mouseenter", () => clearInterval(autoTimer));
    document.querySelector(".carousel-shell").addEventListener("mouseleave", resetAuto);

    buildDots();
    updateCarousel();
    resetAuto();

    // FAQ Accordion
    document.querySelectorAll(".faq-button").forEach((button) => {
      button.addEventListener("click", () => {
        const item = button.parentElement;
        item.classList.toggle("open");
      });
    });
  </script>
